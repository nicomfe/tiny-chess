# Copy to .env and fill in. Never commit .env.

# Keys the player token hashes. Generate with: openssl rand -hex 32
APP_SECRET=

# The public origin of this install, e.g. https://chess.example.com. Left empty,
# links are built from the request host — fine locally, but set it in production
# so a spoofed Host header cannot mint links pointing elsewhere.
APP_BASE_URL=

DB_HOST=db
DB_PORT=3306
DB_NAME=chess
DB_USER=chess
DB_PASSWORD=chess

# Local-only Docker settings
DB_ROOT_PASSWORD=root
WEB_PORT=8080
DB_EXPOSED_PORT=3307
